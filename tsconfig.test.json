{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**/*.ts",
    "src/app/test/**/*.ts",
    "src/app/tests/**/*.ts",
    "src/app/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
